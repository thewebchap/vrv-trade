# TradePilot configuration. Copy to .env (git-ignored) and fill in. Loaded from the project root;
# real environment variables override it. A blank value means "use the default shown".
# Relative paths are taken from the project root.

# ---- Microsoft Graph, Outlook mode only (delegated OAuth, device-code sign-in)
# Entra admin center > App registrations > VRV TradePilot > Overview
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=
# MSAL token cache (contains your sign-in: keep private). Default: .token_cache.json
MICROSOFT_TOKEN_CACHE=.token_cache.json

# ---- Email intake
ALLOWED_SENDER_DOMAIN=vrvglobal.com
POLL_INTERVAL_SECONDS=30
# PDF attachments larger than this are ignored
MAX_PDF_MB=25

# ---- Storage (trade folders, trade_register.xlsx; git-ignored)
TRADE_STORAGE_PATH=trade
# Processed-message state. Blank = <TRADE_STORAGE_PATH>/tradepilot_state.db
SQLITE_PATH=

# ---- Logging: DEBUG | INFO | WARNING | ERROR (the -q flag forces WARNING)
LOG_LEVEL=INFO

# ---- Local model (Ollama; runs on this machine only)
LOCAL_MODEL_PROVIDER=ollama
LOCAL_MODEL_NAME=qwen3-vl:8b-instruct
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_MODEL_TIMEOUT=300
LOCAL_MODEL_NUM_CTX=8192

# ---- Verification engine
TRADEPILOT_OCR_DPI=300
TRADEPILOT_CACHE_DIR=.tradepilot_cache
TRADEPILOT_OWN_COMPANY=VRV GLOBAL
TRADEPILOT_CHECKLIST=Documents/Basic Checklist.xlsx
